#include <windows.h>
1 RT_MANIFEST "app.manifest"
101 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Polaris-Void"
            VALUE "FileDescription",  "Polaris-Void CYBER TOOLKIT - all-in-one Windows utilities hub"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "PolarisKit"
            VALUE "OriginalFilename", "PolarisKit.exe"
            VALUE "ProductName",      "PolarisKit Cyber Toolkit"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
